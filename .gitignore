# Rust
/target
**/target
Cargo.lock
# (workspace Cargo.lock IS committed for binary crates; we are mixed — committing for now)
!Cargo.lock

# Node / Svelte
node_modules/
.svelte-kit/
build/
dist/
.vite/

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/dist/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local env / secrets
.env
.env.local
*.pem
*.key

# Python sidecars
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local state
.prismatik/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Logs
*.log

# Generated bindings (regenerated on build)
packages/api-client/generated/

# Generated SBOMs (P0-SS-06). cargo-cyclonedx writes one *.cdx.json per crate;
# scripts/generate-sbom.{sh,ps1} sweep them into artifacts/sbom/. They are
# regenerable inventory output and churn on every dependency bump, so the
# directory is tracked via its README only.
*.cdx.json
artifacts/sbom/*
!artifacts/sbom/README.md

# Coverage / test artifacts
.tarpaulin/
coverage/
lcov.info

# Reference corpus (build-excluded per spec)
reference/
