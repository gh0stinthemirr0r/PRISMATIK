# Rust
/target
**/target
Cargo.lock
# (workspace Cargo.lock IS committed for binary crates; we are mixed — committing for now)
!Cargo.lock

# Node / Svelte
node_modules/
.svelte-kit/
build/
dist/
.vite/

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/dist/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local env / secrets
.env
.env.local
*.pem
*.key

# Python sidecars
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local state
.prismatik/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Logs
*.log

# Generated bindings (regenerated on build)
packages/api-client/generated/

# Generated SBOMs (P0-SS-06). cargo-cyclonedx writes one *.cdx.json per crate;
# scripts/generate-sbom.{sh,ps1} sweep them into artifacts/sbom/. They are
# regenerable inventory output and churn on every dependency bump, so the
# directory is tracked via its README only.
*.cdx.json
artifacts/sbom/*
!artifacts/sbom/README.md

# Coverage / test artifacts
.tarpaulin/
coverage/
lcov.info

# Reference corpus (build-excluded per spec)
reference/

# Working design documents. Kept on disk, out of the repository: they are
# drafting material rather than deliverables, and DOCS2 alone is ~10MB.
/DOCS/
/DOCS2/

# Vendored third-party source kept locally for reading, not for distribution.
# 1.8GB of other projects' code under their own licences; committing it would
# make every clone enormous and muddle this repository's provenance.
/references/

# Sidecar services that carry their own git history. Committing them as plain
# directories would produce a repository whose clones silently lack them; if
# they are ever needed in CI they should be added as submodules.
/services/mirofish/
/services/kronos-sidecar/kronos/

# Stray import: a URL saved as a filename.
/https:--github.com-aarora4-Awesome-Prediction-Market-.txt

# Superseded v0.1 tree, kept on disk for reference only.
/legacy-v0.1/
