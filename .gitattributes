# Normalize line endings; PRISMATIK standard is LF.
* text=auto eol=lf

# Binary file types — never diff/merge as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.docx binary
*.xlsx binary
*.parquet binary
*.sqlite binary
*.sqlite-shm binary
*.sqlite-wal binary

# Generated artifacts — exclude from GitHub language stats.
*.rs linguist-language=Rust
Cargo.lock linguist-generated=false
packages/api-client/generated/** linguist-generated=true
